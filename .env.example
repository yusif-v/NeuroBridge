# Shared secret the game engine sends as X-Engine-Key
BUGLENS_ENGINE_KEY=dev-engine-key
# Where the SQLite DB and screenshots live (default: ./data)
BUGLENS_DATA_DIR=./data
# AI teammate: put model/provider keys here (never commit .env)
GEMINI_API_KEY=
GEMINI_MODEL=

# Build upload worker: model is local; game runs offline in Docker.
BUGLENS_SANDBOX_IMAGE=buglens-sandbox:local
BUGLENS_LAYA_MODEL=
BUGLENS_LAYA_SDK=
BUGLENS_PLAYTEST_TIMEOUT=600
